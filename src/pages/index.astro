---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Timeline from '@/components/Timeline.astro';
import SkillBadges from '@/components/SkillBadges.astro';
import DockNav from '@/components/DockNav.astro';
import Footer from '@/components/Footer.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import {
    profile,
    about,
    workExperience,
    education,
    skills,
} from '@/data/content';

const fullTimeExperience = workExperience.filter(
    (job) => job.employmentType === 'Full-time'
);
const volunteerContractExperience = workExperience.filter(
    (job) => job.employmentType !== 'Full-time'
);

const experienceItems = fullTimeExperience.map((job) => ({
    title: job.role,
    subtitle: `${job.company} • ${job.employmentType}`,
    dateRange: job.dateRange,
    description: job.description,
    badges: [job.location],
    logo: job.logo,
    stack: job.stack,
}));

const volunteerContractItems = volunteerContractExperience.map((job) => ({
    title: job.role,
    subtitle: `${job.company} • ${job.employmentType}`,
    dateRange: job.dateRange,
    description: job.description,
    badges: [job.location],
    logo: job.logo,
    stack: job.stack,
}));

const educationItems = education.map((edu) => ({
    title: edu.degree,
    subtitle: edu.school,
    dateRange: edu.dateRange,
    logo: edu.logo,
    stack: edu.stack,
    image: edu.image,
}));
---

<BaseLayout
    title={`${profile.name}`}
    description={about.substring(0, 150) + '...'}
>
    <div class="fixed top-8 right-8 z-50">
        <ThemeToggle />
    </div>

    <main class="relative pb-40">
        <Hero profile={profile} about={about} />

        <Timeline
            id="experience"
            title="Work Experience"
            items={experienceItems}
        />

        <Timeline
            id="additional-experience"
            title="Additional Experience"
            items={volunteerContractItems}
        />

        <Timeline id="education" title="Education" items={educationItems} />

        <SkillBadges skills={skills} />

        <DockNav />
    </main>

    <Footer />
</BaseLayout>
