---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Timeline from '@/components/Timeline.astro';
import SkillBadges from '@/components/SkillBadges.astro';
import DockNav from '@/components/DockNav.astro';
import Footer from '@/components/Footer.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import {
    profile,
    about,
    workExperience,
    education,
    skills,
} from '@/data/content';

const fullTimeExperience = workExperience.filter(
    (job) => job.employmentType === 'Full-time'
);
const volunteerContractExperience = workExperience.filter(
    (job) => job.employmentType !== 'Full-time'
);

const experienceItems = fullTimeExperience.map((job) => ({
    title: job.role,
    subtitle: `${job.company} • ${job.employmentType}`,
    dateRange: job.dateRange,
    description: job.description,
    badges: [job.location],
    logo: job.logo,
    logoAlt: `${job.company} logo`,
    stack: job.stack,
}));

const volunteerContractItems = volunteerContractExperience.map((job) => ({
    title: job.role,
    subtitle: `${job.company} • ${job.employmentType}`,
    dateRange: job.dateRange,
    description: job.description,
    badges: [job.location],
    logo: job.logo,
    logoAlt: `${job.company} logo`,
    stack: job.stack,
}));

const educationItems = education.map((edu) => ({
    title: edu.degree,
    subtitle: edu.school,
    dateRange: edu.dateRange,
    logo: edu.logo,
    logoAlt: `${edu.school} logo`,
    stack: edu.stack,
    image: edu.image,
    imageAlt: edu.imageAlt,
}));
---

<BaseLayout
    title={`${profile.name}`}
    description={about.substring(0, 150) + '...'}
>
    <div class="absolute top-4 right-4 z-50 md:fixed md:top-8 md:right-8">
        <ThemeToggle />
    </div>

    <main class="relative pb-16 md:pb-24">
        <Hero profile={profile} about={about} />

        <Timeline
            id="experience"
            title="Work Experience"
            number="01"
            items={experienceItems}
        />

        <Timeline
            id="additional-experience"
            title="Additional Experience"
            number="02"
            items={volunteerContractItems}
        />

        <Timeline
            id="education"
            title="Education"
            number="03"
            items={educationItems}
        />

        <SkillBadges skills={skills} number="04" />

        <DockNav />
    </main>

    <Footer />
</BaseLayout>
