---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Timeline from '@/components/Timeline.astro';
import SkillBadges from '@/components/SkillBadges.astro';
import DockNav from '@/components/DockNav.astro';
import Footer from '@/components/Footer.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import {
    profile,
    about,
    workExperience,
    education,
    skills,
} from '@/data/content';

const fullTimeExperience = workExperience.filter(
    (job) => job.employmentType === 'Full-time'
);
const volunteerContractExperience = workExperience.filter(
    (job) => job.employmentType !== 'Full-time'
);

const experienceItems = fullTimeExperience.map((job) => ({
    title: job.role,
    subtitle: `${job.company} • ${job.employmentType}`,
    dateRange: job.dateRange,
    description: job.description,
    badges: [job.location],
    logo: job.logo,
    stack: job.stack,
}));

const volunteerContractItems = volunteerContractExperience.map((job) => ({
    title: job.role,
    subtitle: `${job.company} • ${job.employmentType}`,
    dateRange: job.dateRange,
    description: job.description,
    badges: [job.location],
    logo: job.logo,
    stack: job.stack,
}));

const educationItems = education.map((edu) => ({
    title: edu.degree,
    subtitle: edu.school,
    dateRange: edu.dateRange,
    logo: edu.logo,
    stack: edu.stack,
    image: edu.image,
}));
---

<BaseLayout
    title={`${profile.name}`}
    description={about.substring(0, 150) + '...'}
>
    <div class="mx-auto max-w-300 px-3 sm:px-6">
        <div class="border-outline-variant border-x">
            <header
                class="bg-surface/85 border-outline-variant sticky top-0 z-40 flex items-center justify-between gap-4 border-b px-4 py-3 backdrop-blur-sm sm:px-6"
            >
                <span class="label-sm">
                    <span class="text-primary">{profile.initials}</span> / Portfolio
                </span>
                <span class="label-sm hidden sm:block">
                    {profile.location}
                </span>
                <ThemeToggle />
            </header>

            <main>
                <Hero profile={profile} about={about} />

                <Timeline
                    id="experience"
                    index="02"
                    title="Work Experience"
                    items={experienceItems}
                />

                <Timeline
                    id="additional-experience"
                    index="03"
                    title="Additional Experience"
                    items={volunteerContractItems}
                />

                <Timeline
                    id="education"
                    index="04"
                    title="Education"
                    items={educationItems}
                />

                <SkillBadges index="05" skills={skills} />
            </main>

            <Footer />
        </div>
    </div>

    <DockNav />
</BaseLayout>
