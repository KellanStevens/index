---
import profileImage from '@/images/Kellan.jpg';

interface Props {
  name: string;
  title: string;
  location: string;
  email: string;
  linkedinUrl: string;
}

const { name, title, location, email, linkedinUrl } = Astro.props;
---

<header class="space-y-4">
  <div class="flex flex-wrap items-start gap-4">
    <img
      src={profileImage.src}
      alt={name}
      width={64}
      height={64}
      class="h-16 w-16 shrink-0 rounded-full object-cover ring-2 ring-border"
      loading="eager"
      fetchpriority="high"
    />
    <div class="min-w-0 flex-1 space-y-1">
      <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
        {name}
      </h1>
      <p class="text-base text-muted-foreground">{title}</p>
      <p class="text-sm text-muted-foreground">{location}</p>
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
      >
        {email}
      </a>
    </div>
  </div>
</header>
