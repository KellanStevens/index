---
import { HugeiconsIcon } from '@hugeicons/react';
import {
    Moon02Icon,
    Sun01Icon,
    ModernTvIcon,
} from '@hugeicons/core-free-icons';
---

<div class="relative" id="theme-toggle-container">
    <button
        id="theme-toggle-btn"
        class="focus-visible:ring-ring border-input bg-surface-container-lowest hover:bg-surface-container hover:text-on-surface text-on-surface inline-flex h-10 w-10 items-center justify-center rounded-full border text-sm font-medium whitespace-nowrap shadow-[0_4px_12px_rgba(0,0,0,0.05)] transition-colors focus-visible:ring-1 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50"
        aria-label="Toggle theme"
    >
        <HugeiconsIcon
            icon={Moon02Icon}
            size={20}
            strokeWidth={2}
            id="theme-icon-dark"
        />
        <HugeiconsIcon
            icon={Sun01Icon}
            size={20}
            strokeWidth={2}
            id="theme-icon-light"
        />
        <HugeiconsIcon
            icon={ModernTvIcon}
            size={20}
            strokeWidth={2}
            id="theme-icon-system"
        />
    </button>

    <div
        id="theme-dropdown"
        class="border-outline-variant/20 bg-surface-container-lowest text-on-surface absolute top-full right-0 z-50 mt-2 hidden min-w-[8rem] overflow-hidden rounded-xl border p-2 shadow-[0_10px_40px_rgba(45,51,56,0.08)]"
    >
        <button
            data-theme-value="light"
            class="hover:bg-surface-container-low hover:text-on-surface relative flex w-full cursor-pointer items-center rounded-lg px-3 py-2 text-sm transition-colors outline-none select-none"
        >
            <HugeiconsIcon
                icon={Moon02Icon}
                size={20}
                strokeWidth={2}
                id="theme-icon-dark"
                className="mr-2"
            />
            Light
        </button>
        <button
            data-theme-value="dark"
            class="hover:bg-surface-container-low hover:text-on-surface relative mt-1 flex w-full cursor-pointer items-center rounded-lg px-3 py-2 text-sm transition-colors outline-none select-none"
        >
            <HugeiconsIcon
                icon={Sun01Icon}
                size={20}
                strokeWidth={2}
                id="theme-icon-light"
                className="mr-2"
            />
            Dark
        </button>
        <button
            data-theme-value="system"
            class="hover:bg-surface-container-low hover:text-on-surface relative mt-1 flex w-full cursor-pointer items-center rounded-lg px-3 py-2 text-sm transition-colors outline-none select-none"
        >
            <HugeiconsIcon
                icon={ModernTvIcon}
                size={20}
                strokeWidth={2}
                id="theme-icon-system"
                className="mr-2"
            />
            System
        </button>
    </div>
</div>

<script is:inline>
    const STORAGE_KEY = 'theme';
    const container = document.getElementById('theme-toggle-container');
    const btn = document.getElementById('theme-toggle-btn');
    const dropdown = document.getElementById('theme-dropdown');
    const icons = {
        light: document.getElementById('theme-icon-light'),
        dark: document.getElementById('theme-icon-dark'),
        system: document.getElementById('theme-icon-system'),
    };
    const themeButtons = dropdown.querySelectorAll('[data-theme-value]');

    function getStoredTheme() {
        if (typeof localStorage === 'undefined') return 'system';
        const s = localStorage.getItem(STORAGE_KEY);
        return s === 'light' || s === 'dark' || s === 'system' ? s : 'system';
    }

    function applyTheme(theme) {
        const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)',
        ).matches;
        const dark = theme === 'dark' || (theme === 'system' && prefersDark);
        document.documentElement.classList.toggle('dark', dark);
    }

    function updateActiveState(theme) {
        Object.values(icons).forEach((icon) => icon.classList.add('hidden'));
        if (icons[theme]) icons[theme].classList.remove('hidden');

        themeButtons.forEach((button) => {
            if (button.dataset.themeValue === theme) {
                button.classList.add(
                    'text-primary',
                    'font-medium',
                    'bg-surface-container-highest',
                );
            } else {
                button.classList.remove(
                    'text-primary',
                    'font-medium',
                    'bg-surface-container-highest',
                );
            }
        });
    }

    function selectTheme(chosen) {
        localStorage.setItem(STORAGE_KEY, chosen);
        applyTheme(chosen);
        updateActiveState(chosen);
        closeDropdown();
    }

    function toggleDropdown() {
        dropdown.classList.toggle('hidden');
    }

    function closeDropdown() {
        dropdown.classList.add('hidden');
    }

    const currentTheme = getStoredTheme();
    updateActiveState(currentTheme);

    btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown();
    });

    themeButtons.forEach((button) => {
        button.addEventListener('click', () => {
            selectTheme(button.dataset.themeValue);
        });
    });

    document.addEventListener('click', (e) => {
        if (!container.contains(e.target)) {
            closeDropdown();
        }
    });

    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener('change', () => {
        if (getStoredTheme() === 'system') {
            applyTheme('system');
        }
    });
</script>
