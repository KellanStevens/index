---
interface Props {
    skills: readonly string[];
}

const { skills } = Astro.props;
---

<section id="skills" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-24">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
            <h2 class="label-md pt-2">Technical Stack</h2>
        </div>
        <div class="lg:col-span-8">
            <div class="flex flex-wrap gap-2 md:gap-3">
                {
                    skills.map((skill) => (
                        <div class="bg-surface-container-lowest body-lg text-on-surface hover:bg-surface-container-high border-outline-variant/10 cursor-default rounded-full border px-4 py-2 shadow-sm md:px-6 md:py-3 transition-all duration-300 hover:scale-105">
                            {skill}
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
