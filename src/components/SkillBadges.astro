---
interface Props {
    skills: readonly string[];
}

const { skills } = Astro.props;
---

<section id="skills" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
        <div class="md:col-span-4">
            <h2 class="label-md pt-2">Technical Stack</h2>
        </div>
        <div class="md:col-span-8">
            <div class="flex flex-wrap gap-3">
                {
                    skills.map((skill) => (
                        <div class="bg-surface-container-lowest body-lg text-on-surface hover:bg-surface-container-high border-outline-variant/10 cursor-default rounded-full border px-6 py-3 shadow-sm transition-all duration-300 hover:scale-105">
                            {skill}
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
