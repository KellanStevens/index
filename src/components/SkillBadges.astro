---
interface Props {
    skills: readonly string[];
    /** Section number, shown before the title. */
    index: string;
}

const { skills, index } = Astro.props;
---

<section id="skills" class="bp-mark border-outline-variant scroll-mt-16 border-t">
    <div class="grid grid-cols-1 lg:grid-cols-12">
        <div
            class="border-outline-variant border-b p-4 sm:p-6 lg:col-span-3 lg:border-r lg:border-b-0"
        >
            <h2 class="label-md">
                <span class="text-primary">{index}</span> / Technical Stack
            </h2>
        </div>
        <!-- The grid is one pixel wider and taller than its frame, which hides the outer cell borders. -->
        <div class="overflow-hidden lg:col-span-9">
            <ul class="-mr-px -mb-px grid grid-cols-2 sm:grid-cols-3">
                {
                    skills.map((skill, i) => (
                        <li class="border-outline-variant hover:bg-surface-container-low/70 flex flex-col gap-6 border-r border-b p-4 transition-colors sm:p-6">
                            <span class="label-sm text-primary">
                                {String(i + 1).padStart(2, '0')}
                            </span>
                            <span class="text-lg font-semibold tracking-tight sm:text-xl">
                                {skill}
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>
