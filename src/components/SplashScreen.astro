---
import '@/styles/components/splash-screen.css';

const name = 'Kellan';
const letters = name.split('');
---

<div
    id="splash-screen"
    class="bp-grid fixed inset-0 z-[9999] flex flex-col items-center justify-center overflow-hidden"
>
    <div class="overflow-hidden p-4">
        <h1
            class="splash-text flex font-kaftan text-7xl tracking-tight sm:text-9xl lg:text-[17rem]"
        >
            {
                letters.map((letter) => (
                    <span class="relative inline-flex items-center justify-center">
                        <span class="invisible">{letter}</span>
                        <span class="splash-letter absolute inset-0 flex items-center justify-center">
                            {letter}
                        </span>
                    </span>
                ))
            }
        </h1>
    </div>

    <!--
        The exit: a copy of the sheet as an SVG, with the name cut out of it.
        scripts/components/splash-zoom.ts sizes it, puts it in place of the
        HTML name and zooms through a letter.
    -->
    <svg id="splash-knockout" aria-hidden="true" focusable="false">
        <defs>
            <pattern id="splash-grid-minor" patternUnits="userSpaceOnUse">
                <path class="splash-grid-minor"></path>
            </pattern>
            <pattern id="splash-grid-major" patternUnits="userSpaceOnUse">
                <path class="splash-grid-major"></path>
            </pattern>
            <mask id="splash-mask" maskUnits="userSpaceOnUse">
                <rect class="splash-full" fill="#fff"></rect>
                <g class="splash-zoom"><text fill="#000"></text></g>
            </mask>
        </defs>
        <g mask="url(#splash-mask)">
            <rect class="splash-full splash-sheet"></rect>
            <g class="splash-grid">
                <rect class="splash-full" fill="url(#splash-grid-minor)"></rect>
                <rect class="splash-full" fill="url(#splash-grid-major)"></rect>
            </g>
        </g>
        <g class="splash-zoom splash-ink"><text></text></g>
    </svg>
</div>

<script src="@/scripts/components/splash-screen.ts"></script>
