---
import '@/styles/splash-screen.css'
---

<div
    id="splash-screen"
    class="fixed inset-0 z-[9999] dark:bg-white bg-black flex flex-col items-center justify-center text-black overflow-hidden"
    style="clip-path: url(#splash-wave-clip);"
>
    <div class="overflow-hidden p-4">
        <h1
            class="splash-text text-white dark:text-black font-kaftan text-7xl sm:text-9xl md:text-[17rem] tracking-tight"
        >
            Kellan
        </h1>
    </div>
</div>

<script src="@/scripts/splash-screen.ts"></script>
