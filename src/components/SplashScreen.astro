---
import '@/styles/components/splash-screen.css';

const name = 'Kellan';
const letters = name.split('');
---

<div
    id="splash-screen"
    class="fixed inset-0 z-[9999] flex flex-col items-center justify-center overflow-hidden bg-black text-black dark:bg-white"
    style="clip-path: url(#splash-wave-clip);"
>
    <div class="overflow-hidden p-4">
        <h1
            class="splash-text flex font-kaftan text-7xl tracking-tight text-white sm:text-9xl md:text-[17rem] dark:text-black"
        >
            {
                letters.map((letter) => (
                    <span class="relative inline-flex items-center justify-center">
                        <span class="invisible">{letter}</span>
                        <span class="hover-letter absolute inset-0 flex cursor-default items-center justify-center transition-all duration-75">
                            {letter}
                        </span>
                    </span>
                ))
            }
        </h1>
    </div>
</div>

<script src="@/scripts/ui/font-hover.ts"></script>
<script src="@/scripts/components/splash-screen.ts"></script>
