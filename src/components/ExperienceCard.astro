---
import Card from '@/components/ui/Card.astro';
import CardHeader from '@/components/ui/CardHeader.astro';
import CardContent from '@/components/ui/CardContent.astro';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  role: string;
  location: string;
  dateRange: string;
  company: string;
  employmentType: string;
}

const { role, location, dateRange, company, employmentType } = Astro.props;
---

<Card>
  <CardHeader>
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div class="space-y-1">
        <h3 class="font-semibold leading-none tracking-tight text-foreground">
          {role}
        </h3>
        <p class="text-sm text-muted-foreground">{location}</p>
      </div>
      <div class="flex flex-col items-end gap-1 text-right">
        <span class="text-sm text-muted-foreground">{dateRange}</span>
        <Badge variant="outline">{employmentType}</Badge>
      </div>
    </div>
    <p class="text-sm font-medium text-muted-foreground">{company}</p>
  </CardHeader>
  <CardContent>
    <p class="text-sm leading-relaxed text-muted-foreground">
      <slot />
    </p>
  </CardContent>
</Card>
