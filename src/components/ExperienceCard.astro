---
import Card from '@/components/ui/Card.astro';
import CardHeader from '@/components/ui/CardHeader.astro';
import CardContent from '@/components/ui/CardContent.astro';
import Badge from '@/components/ui/Badge.astro';

interface Props {
    role: string;
    location: string;
    dateRange: string;
    company: string;
    employmentType: string;
}

const { role, location, dateRange, company, employmentType } = Astro.props;
---

<Card>
    <CardHeader>
        <div class="flex flex-wrap items-start justify-between gap-2">
            <div class="space-y-1">
                <h3
                    class="text-foreground leading-none font-semibold tracking-tight"
                >
                    {role}
                </h3>
                <p class="text-muted-foreground text-sm">{location}</p>
            </div>
            <div class="flex flex-col items-end gap-1 text-right">
                <span class="text-muted-foreground text-sm">{dateRange}</span>
                <Badge variant="outline">{employmentType}</Badge>
            </div>
        </div>
        <p class="text-muted-foreground text-sm font-medium">{company}</p>
    </CardHeader>
    <CardContent>
        <p class="text-muted-foreground text-sm leading-relaxed">
            <slot />
        </p>
    </CardContent>
</Card>
