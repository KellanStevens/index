---

<div class="fixed bottom-8 left-1/2 z-50 -translate-x-1/2">
    <nav
        class="bg-surface/80 border-outline-variant/20 flex items-center gap-2 rounded-full border p-2 shadow-[0_10px_40px_rgba(45,51,56,0.08)] backdrop-blur-xl"
    >
        <a
            href="#experience"
            class="dock-link text-on-surface label-sm hover:bg-surface-container rounded-full px-6 py-3 transition-all duration-300"
            >Experience</a
        >
        <a
            href="#education"
            class="dock-link text-on-surface label-sm hover:bg-surface-container rounded-full px-6 py-3 transition-all duration-300"
            >Education</a
        >
        <a
            href="#skills"
            class="dock-link text-on-surface label-sm hover:bg-surface-container rounded-full px-6 py-3 transition-all duration-300"
            >Skills</a
        >
    </nav>
</div>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('.dock-link');

        const observerOptions = {
            root: null,
            rootMargin: '-20% 0px -70% 0px',
            threshold: 0,
        };

        const activateLink = (id) => {
            navLinks.forEach((link) => {
                link.classList.remove(
                    'bg-surface-container-highest',
                    'shadow-[0_2px_10px_rgba(0,0,0,0.05)]',
                    'text-primary',
                );
                if (link.getAttribute('href') === `#${id}`) {
                    link.classList.add(
                        'bg-surface-container-highest',
                        'shadow-[0_2px_10px_rgba(0,0,0,0.05)]',
                        'text-primary',
                    );
                }
            });
        };

        const observerCallback = (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    activateLink(entry.target.getAttribute('id'));
                }
            });
        };

        const observer = new IntersectionObserver(
            observerCallback,
            observerOptions,
        );
        sections.forEach((sec) => observer.observe(sec));

        for (const sec of sections) {
            const rect = sec.getBoundingClientRect();
            if (
                rect.top <= window.innerHeight * 0.3 &&
                rect.bottom >= window.innerHeight * 0.3
            ) {
                activateLink(sec.id);
                break;
            }
        }
    });
</script>
