---
const links = [
    { href: '#experience', label: 'Experience', shortLabel: 'Work' },
    { href: '#additional-experience', label: 'Additional', shortLabel: 'Other' },
    { href: '#education', label: 'Education', shortLabel: 'Education' },
    { href: '#skills', label: 'Skills', shortLabel: 'Skills' },
];
---

<div
    class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex justify-center px-2 md:bottom-8"
>
    <nav
        class="bg-surface border-outline shadow-hard pointer-events-auto flex max-w-full items-center gap-1 border p-1"
    >
        {
            links.map((link) => (
                <a
                    href={link.href}
                    class="dock-link label-sm text-on-surface data-active:bg-on-surface data-active:text-surface not-data-active:hover:bg-surface-container-high px-2.5 py-3 whitespace-nowrap transition-colors sm:px-5"
                >
                    <span class="sm:hidden">{link.shortLabel}</span>
                    <span class="hidden sm:inline">{link.label}</span>
                </a>
            ))
        }
    </nav>
</div>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('.dock-link');

        const observerOptions = {
            root: null,
            rootMargin: '-20% 0px -70% 0px',
            threshold: 0,
        };

        const activateLink = (id) => {
            navLinks.forEach((link) => {
                link.toggleAttribute(
                    'data-active',
                    link.getAttribute('href') === `#${id}`,
                );
            });
        };

        const observerCallback = (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    activateLink(entry.target.getAttribute('id'));
                }
            });
        };

        const observer = new IntersectionObserver(
            observerCallback,
            observerOptions,
        );
        sections.forEach((sec) => observer.observe(sec));

        for (const sec of sections) {
            const rect = sec.getBoundingClientRect();
            if (
                rect.top <= window.innerHeight * 0.3 &&
                rect.bottom >= window.innerHeight * 0.3
            ) {
                activateLink(sec.id);
                break;
            }
        }
    });
</script>
