---
const links = [
    { href: '#experience', label: 'Experience', shortLabel: 'Work' },
    { href: '#additional-experience', label: 'Additional', shortLabel: 'Other' },
    { href: '#education', label: 'Education', shortLabel: 'Education' },
    { href: '#skills', label: 'Skills', shortLabel: 'Skills' },
];
---

<div
    class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex justify-center px-2 md:bottom-8"
>
    <nav
        class="bg-surface/80 border-outline-variant/20 pointer-events-auto flex max-w-full items-center gap-1 rounded-full border p-1.5 shadow-[0_10px_40px_rgba(45,51,56,0.08)] backdrop-blur-xl sm:gap-2 sm:p-2"
    >
        {
            links.map((link) => (
                <a
                    href={link.href}
                    class="dock-link text-on-surface label-sm hover:bg-surface-container rounded-full px-2.5 py-3.5 whitespace-nowrap transition-all duration-300 sm:px-6 sm:py-3"
                >
                    <span class="sm:hidden">{link.shortLabel}</span>
                    <span class="hidden sm:inline">{link.label}</span>
                </a>
            ))
        }
    </nav>
</div>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('.dock-link');

        const observerOptions = {
            root: null,
            rootMargin: '-20% 0px -70% 0px',
            threshold: 0,
        };

        const activateLink = (id) => {
            navLinks.forEach((link) => {
                link.classList.remove(
                    'bg-surface-container-highest',
                    'shadow-[0_2px_10px_rgba(0,0,0,0.05)]',
                    'text-primary',
                );
                if (link.getAttribute('href') === `#${id}`) {
                    link.classList.add(
                        'bg-surface-container-highest',
                        'shadow-[0_2px_10px_rgba(0,0,0,0.05)]',
                        'text-primary',
                    );
                }
            });
        };

        const observerCallback = (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    activateLink(entry.target.getAttribute('id'));
                }
            });
        };

        const observer = new IntersectionObserver(
            observerCallback,
            observerOptions,
        );
        sections.forEach((sec) => observer.observe(sec));

        for (const sec of sections) {
            const rect = sec.getBoundingClientRect();
            if (
                rect.top <= window.innerHeight * 0.3 &&
                rect.bottom >= window.innerHeight * 0.3
            ) {
                activateLink(sec.id);
                break;
            }
        }
    });
</script>
