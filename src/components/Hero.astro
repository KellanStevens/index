---
import Dithered from '@/components/Dithered.astro';
import portrait from '@/images/dithered/kellan.png';
import type { profile as Profile } from '@/data/content';

interface Props {
    profile: typeof Profile;
    about: string;
}

const { profile, about } = Astro.props;
const [firstName, ...lastNames] = profile.name.split(' ');
---

<section
    class="mx-auto flex max-w-7xl flex-col justify-center px-4 pt-20 pb-12 sm:px-6 lg:min-h-screen lg:px-8 lg:py-24"
>
    <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-2">
        <div class="space-y-6 lg:self-end">
            <span class="label-md block">{profile.location}</span>
            <h1 class="display-lg">
                {firstName}<br />{lastNames.join(' ')}
            </h1>
        </div>

        <figure
            class="w-fit lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center lg:justify-self-end"
        >
            <div class="relative">
                <div
                    class="dither-50 absolute inset-0 translate-x-2 translate-y-2"
                >
                </div>
                <div
                    class="border-outline bg-surface relative box-content w-72 border sm:w-96"
                >
                    <Dithered
                        src={portrait}
                        alt={`Portrait of ${profile.name}`}
                        loading="eager"
                        class="w-full"
                    />
                </div>
            </div>
            <figcaption class="label-sm mt-5 flex justify-between gap-4">
                <span>Fig. 01 — 1-bit</span>
                <span>Est. 2002</span>
            </figcaption>
        </figure>

        <div class="space-y-8 lg:self-start">
            <p class="body-lg max-w-xl">
                {profile.title}
            </p>

            <div class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap xl:gap-4">
                <a
                    href={`mailto:${profile.email}`}
                    class="bg-primary text-on-primary border-outline label-md hover:shadow-hard col-span-2 border px-5 py-4 text-center transition-all hover:-translate-x-1 hover:-translate-y-1 xl:px-8"
                >
                    Contact Me
                </a>
                <a
                    href={profile.linkedinUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-outline text-on-surface label-md hover:bg-on-surface hover:text-surface border px-5 py-4 text-center transition-colors xl:px-8"
                >
                    LinkedIn
                </a>
                <a
                    href={profile.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-outline text-on-surface label-md hover:bg-on-surface hover:text-surface border px-5 py-4 text-center transition-colors xl:px-8"
                >
                    GitHub
                </a>
            </div>
        </div>
    </div>

    <div
        class="border-outline mt-16 grid grid-cols-1 gap-4 border-t pt-6 lg:mt-24 lg:grid-cols-12 lg:gap-12"
    >
        <div class="lg:col-span-4">
            <h2 class="label-md">About</h2>
        </div>
        <div class="lg:col-span-8">
            <p class="body-lg">
                {about}
            </p>
        </div>
    </div>
</section>
