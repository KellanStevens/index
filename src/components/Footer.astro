---
import { profile } from '@/data/content';

const name = profile.name;
const [firstName, ...lastNameParts] = name.split(' ');
const lastName = lastNameParts.join(' ');

const firstLetters = firstName.split('');
const lastLetters = lastName ? (' ' + lastName).split('') : [];
---

<footer
    class="bg-surface-container-lowest border-outline-variant/10 mt-32 flex w-full items-center justify-center overflow-hidden border-t pt-24 pb-48"
>
    <div class="flex w-full justify-center px-[12px] text-center">
        <h2
            id="footer-name"
            class="font-kaftan text-[20vw] sm:text-[21vw] md:text-[11vw] lg:text-[11.5vw] xl:text-[12vw] text-on-surface flex justify-center overflow-hidden leading-none tracking-tight whitespace-nowrap select-none"
        >
            <span class="flex">
                {
                    firstLetters.map((letter) => (
                        <span class="relative inline-flex items-center justify-center">
                            <span class="invisible">{letter}</span>
                            <span class="hover-letter absolute inset-0 flex cursor-default items-center justify-center transition-all duration-75">
                                {letter}
                            </span>
                        </span>
                    ))
                }
            </span>

            <span class="hidden md:flex">
                {
                    lastLetters.map((letter) =>
                        letter === ' ' ? (
                            <span class="w-[3vw]">&nbsp;</span>
                        ) : (
                            <span class="relative inline-flex items-center justify-center">
                                <span class="invisible">{letter}</span>
                                <span class="hover-letter absolute inset-0 flex cursor-default items-center justify-center transition-all duration-75">
                                    {letter}
                                </span>
                            </span>
                        ),
                    )
                }
            </span>
        </h2>
    </div>
</footer>

<script src="@/scripts/footer.ts"></script>
