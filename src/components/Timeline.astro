---
import type { ImageMetadata } from 'astro';
interface TimelineItemProps {
    title: string;
    subtitle: string;
    dateRange: string;
    description?: string;
    badges?: readonly string[];
    logo: ImageMetadata;
    stack?: readonly { name: string; image?: string }[];
    image?: ImageMetadata;
}

interface Props {
    title: string;
    id: string;
    /** Section number, shown before the title and in each item reference. */
    index: string;
    items: TimelineItemProps[];
}

const { title, id, index, items } = Astro.props;
---

<section id={id} class="bp-mark border-outline-variant scroll-mt-16 border-t">
    <div class="grid grid-cols-1 lg:grid-cols-12">
        <div
            class="border-outline-variant border-b p-4 sm:p-6 lg:col-span-3 lg:border-r lg:border-b-0"
        >
            <h2 class="label-md lg:sticky lg:top-20">
                <span class="text-primary">{index}</span> / {title}
            </h2>
        </div>

        <div class="lg:col-span-9">
            {
                items.map((item, i) => (
                    <article class="border-outline-variant hover:bg-surface-container-low/70 flex flex-col gap-4 border-t p-4 transition-colors first:border-t-0 sm:p-6 md:flex-row md:gap-8">
                        <div class="flex shrink-0 items-center gap-4 md:w-40 md:flex-col md:items-start">
                            <img
                                src={item.logo.src}
                                alt={`${item.title} logo`}
                                loading="lazy"
                                class="border-outline-variant h-12 w-12 shrink-0 border bg-white object-cover"
                                width={156}
                                height={156}
                            />
                            <div class="flex flex-col gap-1">
                                <span class="label-sm text-primary">
                                    {index}.{i + 1}
                                </span>
                                <span class="label-sm whitespace-nowrap">
                                    {item.dateRange}
                                </span>
                            </div>
                        </div>

                        <div class="flex min-w-0 flex-1 flex-col gap-6 xl:flex-row xl:gap-8">
                            <div class="min-w-0 flex-1">
                                <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">
                                    {item.title}
                                </h3>
                                <div class="text-primary mt-1 font-mono text-sm">
                                    {item.subtitle}
                                </div>

                                {item.description && (
                                    <p class="body-lg mt-4">
                                        {item.description}
                                    </p>
                                )}
                                {item.badges && item.badges.length > 0 && (
                                    <div class="mt-4 flex flex-wrap gap-2">
                                        {item.badges.map((badge: string) => (
                                            <span class="label-sm border-outline-variant border border-dashed px-2.5 py-1">
                                                {badge}
                                            </span>
                                        ))}
                                    </div>
                                )}
                                {item.stack && item.stack.length > 0 && (
                                    <div class="mt-4 flex flex-wrap gap-2">
                                        {item.stack.map((tech) => (
                                            <div class="border-outline-variant text-on-surface flex items-center gap-2 border px-2.5 py-1 font-mono text-xs">
                                                {tech.image && (
                                                    <img
                                                        src={tech.image}
                                                        alt=""
                                                        class="bp-icon h-3.5 w-3.5 object-contain"
                                                        loading="lazy"
                                                    />
                                                )}
                                                <span>{tech.name}</span>
                                            </div>
                                        ))}
                                    </div>
                                )}
                            </div>

                            {item.image && (
                                <div class="border-outline-variant flex shrink-0 overflow-hidden border xl:w-1/2 xl:self-stretch">
                                    <img
                                        src={item.image.src}
                                        alt={`${item.title} image`}
                                        width={item.image.width}
                                        height={item.image.height}
                                        loading="lazy"
                                        decoding="async"
                                        class="block h-full w-full object-cover"
                                    />
                                </div>
                            )}
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
