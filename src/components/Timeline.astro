---
import type { ImageMetadata } from 'astro';
import Badge from '@/components/ui/Badge.astro';
import Dithered from '@/components/Dithered.astro';

interface TimelineItemProps {
    title: string;
    subtitle: string;
    dateRange: string;
    description?: string;
    badges?: readonly string[];
    /** A dithered logo of 56 dots square. */
    logo: ImageMetadata;
    logoAlt: string;
    stack?: readonly { name: string; image?: string }[];
    /** A dithered photo of 288 dots wide. */
    image?: ImageMetadata;
    imageAlt?: string;
}

interface Props {
    title: string;
    /** The number shown before the title, such as "01". */
    number: string;
    id: string;
    items: TimelineItemProps[];
}

const { title, number, id, items } = Astro.props;
---

<section id={id} class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
    <div
        class="border-outline grid grid-cols-1 gap-8 border-t pt-6 lg:grid-cols-12 lg:gap-12"
    >
        <div class="relative lg:col-span-4">
            <h2 class="label-md sticky top-24 flex gap-4">
                <span class="text-on-surface">{number}</span>
                {title}
            </h2>
        </div>

        <ol class="divide-outline-variant divide-y lg:col-span-8">
            {
                items.map((item) => (
                    <li class="space-y-8 py-8 first:pt-0 last:pb-0 lg:py-10">
                        <div class="flex flex-col gap-5 md:flex-row md:gap-8">
                            <div class="border-outline size-14 shrink-0 border box-content md:size-28">
                                <Dithered
                                    src={item.logo}
                                    alt={item.logoAlt}
                                    class="w-full"
                                />
                            </div>

                            <div class="flex-1">
                                <span class="label-sm block">
                                    {item.dateRange}
                                </span>
                                <h3 class="headline-lg mt-2">{item.title}</h3>
                                <div class="body-lg">{item.subtitle}</div>

                                {item.description && (
                                    <p class="body-lg mt-4">
                                        {item.description}
                                    </p>
                                )}

                                {((item.badges && item.badges.length > 0) ||
                                    (item.stack && item.stack.length > 0)) && (
                                    <div class="mt-5 flex flex-wrap gap-2">
                                        {item.badges?.map((badge) => (
                                            <Badge variant="default">
                                                {badge}
                                            </Badge>
                                        ))}
                                        {item.stack?.map((tech) => (
                                            <Badge variant="outline">
                                                {tech.image && (
                                                    <img
                                                        src={tech.image}
                                                        alt=""
                                                        class="size-3.5 object-contain brightness-0 dark:invert"
                                                        loading="lazy"
                                                    />
                                                )}
                                                {tech.name}
                                            </Badge>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </div>

                        {item.image && (
                            <figure class="w-fit">
                                <div class="border-outline box-content w-72 border md:w-144">
                                    <Dithered
                                        src={item.image}
                                        alt={item.imageAlt ?? ''}
                                        class="w-full"
                                    />
                                </div>
                                {item.imageAlt && (
                                    <figcaption class="label-sm mt-3">
                                        {item.imageAlt}
                                    </figcaption>
                                )}
                            </figure>
                        )}
                    </li>
                ))
            }
        </ol>
    </div>
</section>
