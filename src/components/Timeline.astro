---
import type { ImageMetadata } from 'astro';
interface TimelineItemProps {
    title: string;
    subtitle: string;
    dateRange: string;
    description?: string;
    badges?: readonly string[];
    logo: ImageMetadata;
}

interface Props {
    title: string;
    id: string;
    items: TimelineItemProps[];
}

const { title, id, items } = Astro.props;
---

<section id={id} class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
        <div class="relative md:col-span-4">
            <h2 class="label-md sticky top-24 pt-2">{title}</h2>
        </div>

        <div class="space-y-16 md:col-span-8">
            {
                items.map((item) => (
                    <div class="group bg-surface-container-lowest hover:bg-surface-container-low rounded-3xl p-8 shadow-[0_10px_40px_rgba(45,51,56,0)] transition-colors duration-500 ease-out hover:shadow-[0_10px_40px_rgba(45,51,56,0.04)]">
                        <div class="mb-4 flex flex-col gap-4 md:flex-row md:items-start md:gap-8">
                            <div class="flex items-center gap-4 md:w-32 md:flex-col md:items-start md:gap-4">
                                <img
                                    src={item.logo.src}
                                    alt={`${item.title} logo`}
                                    class="h-14 w-14 shrink-0 rounded-full object-cover bg-white ring-1 ring-outline-variant/30 transition-transform duration-500 group-hover:scale-105 shadow-sm"
                                    width={156}
                                    height={156}
                                />
                                <span class="label-sm text-on-surface-variant whitespace-nowrap pt-1">
                                    {item.dateRange}
                                </span>
                            </div>
                            <div class="flex-1">
                                <h3 class="headline-lg mb-1 text-2xl md:text-3xl">
                                    {item.title}
                                </h3>
                                <div class="body-lg text-primary">
                                    {item.subtitle}
                                </div>
                            </div>
                        </div>

                        {(item.description ||
                            (item.badges && item.badges.length > 0)) && (
                            <div class="md:pl-40">
                                {item.description && (
                                    <p class="body-lg text-on-surface-variant mt-4 leading-relaxed">
                                        {item.description}
                                    </p>
                                )}
                                {item.badges && item.badges.length > 0 && (
                                    <div class="mt-6 flex flex-wrap gap-2">
                                        {item.badges.map((badge: string) => (
                                            <span class="bg-surface-container-highest text-on-surface-variant rounded-full px-3 py-1 text-xs font-medium tracking-wider uppercase">
                                                {badge}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</section>
