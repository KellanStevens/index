---
import type { ImageMetadata } from 'astro';
interface TimelineItemProps {
    title: string;
    subtitle: string;
    dateRange: string;
    description?: string;
    badges?: readonly string[];
    logo: ImageMetadata;
    stack?: readonly { name: string; image?: string }[];
    image?: ImageMetadata;
    /** Fields of the table in the detail sheet. */
    specs?: readonly { label: string; value: string }[];
}

interface Props {
    title: string;
    id: string;
    /** Section number, shown before the title and in each item reference. */
    index: string;
    items: TimelineItemProps[];
}

const { title, id, index, items } = Astro.props;
---

<section id={id} class="bp-mark border-outline-variant scroll-mt-16 border-t">
    <div class="grid grid-cols-1 lg:grid-cols-12">
        <div
            class="border-outline-variant border-b p-4 sm:p-6 lg:col-span-3 lg:border-r lg:border-b-0"
        >
            <h2 class="label-md lg:sticky lg:top-20">
                <span class="text-primary">{index}</span> / {title}
            </h2>
        </div>

        <div class="lg:col-span-9">
            {
                items.map((item, i) => (
                    <article
                        data-detail={`${id}-detail-${i + 1}`}
                        class="bp-detail-trigger border-outline-variant hover:bg-surface-container-low/70 relative flex cursor-pointer flex-col gap-4 border-t p-4 transition-colors first:border-t-0 sm:p-6 md:flex-row md:gap-8"
                    >
                        <div class="flex shrink-0 items-center gap-4 md:w-40 md:flex-col md:items-start">
                            <img
                                src={item.logo.src}
                                alt={`${item.title} logo`}
                                loading="lazy"
                                class="border-outline-variant h-12 w-12 shrink-0 border bg-white object-cover"
                                width={156}
                                height={156}
                            />
                            <div class="flex flex-col gap-1">
                                <span class="label-sm text-primary">
                                    {index}.{i + 1}
                                </span>
                                <span class="label-sm whitespace-nowrap">
                                    {item.dateRange}
                                </span>
                            </div>
                            <button
                                type="button"
                                aria-haspopup="dialog"
                                aria-label={`Details of ${item.title}, ${item.subtitle}`}
                                class="label-sm border-outline-variant hover:bg-surface-container-high hover:text-on-surface focus-visible:ring-ring ml-auto cursor-pointer border px-2.5 py-1 transition-colors focus-visible:ring-1 focus-visible:outline-none md:ml-0"
                            >
                                + Detail
                            </button>
                        </div>

                        <div class="flex min-w-0 flex-1 flex-col gap-6 xl:flex-row xl:gap-8">
                            <div class="min-w-0 flex-1">
                                <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">
                                    {item.title}
                                </h3>
                                <div class="text-primary mt-1 font-mono text-sm">
                                    {item.subtitle}
                                </div>

                                {item.description && (
                                    <p class="body-lg mt-4">
                                        {item.description}
                                    </p>
                                )}
                                {item.badges && item.badges.length > 0 && (
                                    <div class="mt-4 flex flex-wrap gap-2">
                                        {item.badges.map((badge: string) => (
                                            <span class="label-sm border-outline-variant border border-dashed px-2.5 py-1">
                                                {badge}
                                            </span>
                                        ))}
                                    </div>
                                )}
                                {item.stack && item.stack.length > 0 && (
                                    <div class="mt-4 flex flex-wrap gap-2">
                                        {item.stack.map((tech) => (
                                            <div class="border-outline-variant text-on-surface flex items-center gap-2 border px-2.5 py-1 font-mono text-xs">
                                                {tech.image && (
                                                    <img
                                                        src={tech.image}
                                                        alt=""
                                                        class="bp-icon h-3.5 w-3.5 object-contain"
                                                        loading="lazy"
                                                    />
                                                )}
                                                <span>{tech.name}</span>
                                            </div>
                                        ))}
                                    </div>
                                )}
                            </div>

                            {item.image && (
                                <div class="border-outline-variant flex shrink-0 overflow-hidden border xl:w-1/2 xl:self-stretch">
                                    <img
                                        src={item.image.src}
                                        alt={`${item.title} image`}
                                        width={item.image.width}
                                        height={item.image.height}
                                        loading="lazy"
                                        decoding="async"
                                        class="block h-full w-full object-cover"
                                    />
                                </div>
                            )}
                        </div>
                    </article>
                ))
            }
        </div>
    </div>

    {
        items.map((item, i) => (
            <dialog
                id={`${id}-detail-${i + 1}`}
                aria-labelledby={`${id}-detail-${i + 1}-title`}
                class="bp-dialog bp-grid bg-surface text-on-surface border-outline backdrop:bg-surface-dim/70 border backdrop:backdrop-blur-sm"
            >
                <div class="bg-surface/90 border-outline-variant sticky top-0 z-10 flex items-center justify-between gap-4 border-b px-4 py-3 backdrop-blur-sm sm:px-8">
                    <span class="label-sm">
                        <span class="text-primary">
                            {index}.{i + 1}
                        </span>{' '}
                        / {title} / Detail
                    </span>
                    <form method="dialog">
                        <button class="label-sm border-outline-variant hover:bg-surface-container-high hover:text-on-surface focus-visible:ring-ring cursor-pointer border px-2.5 py-1 transition-colors focus-visible:ring-1 focus-visible:outline-none">
                            Close
                        </button>
                    </form>
                </div>

                <div class="flex flex-col gap-6 p-4 sm:gap-8 sm:p-8">
                    <div class="flex items-center gap-4 sm:gap-6">
                        <img
                            src={item.logo.src}
                            alt=""
                            loading="lazy"
                            class="border-outline-variant h-16 w-16 shrink-0 border bg-white object-cover sm:h-20 sm:w-20"
                            width={156}
                            height={156}
                        />
                        <div class="min-w-0">
                            <h3
                                id={`${id}-detail-${i + 1}-title`}
                                class="text-2xl font-semibold tracking-tight sm:text-3xl"
                            >
                                {item.title}
                            </h3>
                            <div class="text-primary mt-1 font-mono text-sm">
                                {item.subtitle}
                            </div>
                        </div>
                    </div>

                    {item.specs && item.specs.length > 0 && (
                        <dl class="border-outline-variant bg-surface grid grid-cols-2 border-t border-l sm:grid-cols-4">
                            {item.specs.map((spec) => (
                                <div class="border-outline-variant flex min-w-0 flex-col gap-2 border-r border-b p-3 sm:p-4">
                                    <dt class="label-sm">{spec.label}</dt>
                                    <dd class="font-mono text-sm">
                                        {spec.value}
                                    </dd>
                                </div>
                            ))}
                        </dl>
                    )}

                    {item.description && (
                        <p class="body-lg text-on-surface">
                            {item.description}
                        </p>
                    )}

                    {item.stack && item.stack.length > 0 && (
                        <div>
                            <h4 class="label-sm mb-3">Stack</h4>
                            <div class="flex flex-wrap gap-2">
                                {item.stack.map((tech) => (
                                    <div class="border-outline-variant bg-surface flex items-center gap-2 border px-3 py-1.5 font-mono text-sm">
                                        {tech.image && (
                                            <img
                                                src={tech.image}
                                                alt=""
                                                class="bp-icon h-4 w-4 object-contain"
                                                loading="lazy"
                                            />
                                        )}
                                        <span>{tech.name}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {item.image && (
                        <img
                            src={item.image.src}
                            alt={`${item.title} image`}
                            width={item.image.width}
                            height={item.image.height}
                            loading="lazy"
                            decoding="async"
                            class="border-outline-variant block h-auto w-full border"
                        />
                    )}
                </div>
            </dialog>
        ))
    }
</section>

<script src="@/scripts/ui/detail-sheet.ts"></script>
